    {
  "type": "custom-template",
  "isAPI": true,
  "api": "/app-api/dict?ParentId=0e28bab2-30fa-74b4-57d5-3a20ea7de51f",
  "html": "<div class=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6 p-6\">\n    {{#rows}}\n    <article class=\"bg-white rounded-xl shadow-md overflow-hidden group relative hover:shadow-2xl hover:-translate-y-3 transition-all duration-500 border border-gray-100 hover:border-blue-300\">\n        <div class=\"absolute inset-0 bg-gradient-to-br from-blue-50/0 via-blue-100/40 to-purple-50/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10\"></div>\n        <div class=\"w-full h-48 sm:h-56 relative overflow-hidden\">\n            <a href=\"/productLists?id={{id}}\" class=\"block w-full h-full\">\n                {{#img}}\n                <img src=\"http://newapi.lightcomm.com/erupt-api/file/download-attachment{{icon}}\" alt=\"{{name}}\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" />\n                {{/img}}\n                {{^img}}\n                <img src=\"http://newapi.lightcomm.com/erupt-api/file/download-attachment{{icon}}\" alt=\"{{name}}\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" />\n                {{/img}}\n            </a>\n        </div>\n        <div class=\"p-6 flex flex-col justify-between relative z-10\">\n            <h3 class=\"mb-3\">\n                <a href=\"/productLists?id={{id}}\" class=\"text-xl font-semibold text-gray-800 hover:text-blue-600 transition-all duration-300 line-clamp-2 group-hover:translate-x-1 inline-block\">\n                    {{name}}\n                </a>\n            </h3>\n            <div>\n                <p class=\"text-gray-600 line-clamp-3 mb-4 group-hover:text-gray-700 transition-colors duration-300\">\n                    {{description}}\n                </p>\n                <a href=\"/productLists?id={{id}}\" class=\"text-blue-600 hover:text-blue-800 font-medium inline-flex items-center transition-all duration-300 hover:translate-x-2\">\n                    更多\n                    <svg class=\"w-4 h-4 ml-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5l7 7-7 7\" />\n                    </svg>\n                </a>\n            </div>\n        </div>\n    </article>\n    {{/rows}}\n</div>",
  "json": null,
  "animate": false
}

  ]
