{
  "title": "新闻中心",
  "body": [
    {
      "type": "title",
      "label": "新闻中心",
      "style": "h1",
      "align": "center"
    },
    {
      "type": "chip-list",
      "elements": [
        {
          "label": "全部",
          "active": true
        },
        {
          "label": "公司新闻"
        },
        {
          "label": "行业动态"
        },
        {
          "label": "技术分享"
        }
      ]
    },

    {
  "type": "custom-template",
  "isAPI": true,
"api": "/app-api/product2?id=1",
  "html": "<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6\">\n    {{#rows}}\n    <article\n        class=\"bg-white hover:bg-gray-50 rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group relative\">\n        <div class=\"w-full h-48 sm:h-56 relative overflow-hidden\">\n            <a href=\"/newDetail?id={{id}}\" class=\"block hover:brightness-95 transition-all duration-200\">\n                {{#img}}\n                <img\n          src=\"http://newapi.lightcomm.com/erupt-api/file/download-attachment{{pdf}}\"\n          alt=\"{{name}}\"\n          class=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\"\n        />\n        {{/img}}\n        {{^img}}\n                <img\n          src=\"http://newapi.lightcomm.com/erupt-api/file/download-attachment{{pdf}}\"\n          alt=\"{{name}}\"\n          class=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\"\n        />\n        {{/img}}\n            </a>\n        </div>\n\n        <div class=\"p-6 flex flex-col justify-between\">\n           \n            <h3 class=\"mb-3 relative z-10\">\n                <a href=\"/newDetail?id={{id}}\"\n                    class=\"text-xl font-semibold text-gray-800 hover:text-blue-600 transition-colors duration-200 line-clamp-2\">\n                    {{name}}\n                </a>\n            </h3>\n\n            <!-- 内容区域背景过渡 -->\n            <div class=\"relative z-10\">\n                <p class=\"text-gray-600 line-clamp-3 mb-4\">\n                    {{description}}\n                </p>\n               <a href=\"/newDetail?id={{id}}\" class=\"group mt-4 inline-flex items-center gap-1 text-sm font-medium text-blue-600\">\n      了解更多\n\n      <span aria-hidden=\"true\" class=\"block transition-all group-hover:ms-0.5 rtl:rotate-180\">\n        &rarr;\n      </span>\n    </a>\n            </div>\n        </div>\n    </article>\n    {{/rows}}\n\n</div>",
  "json": null,
  "animate": false
}
  ]
}
