{
  "title":"Lightcomm-Search",
  "type": "page",
  "config": {
    "title": "Search",
    "slug": "search"
  },
  "body": [
    {
      "type": "search",
      "header": {
        "placeholder": "Please enter keywords search...",
        "tooltip": "Search",
        "enable": true,
        "type": "search",
        "key": "keys",
        "bg": {
          "classes": "bg-cover bg-center",
          "overlay": "bg-black/40",
          "img": {
            "src": "/assets/images/bg/search.png",
            "alt": "搜索背景"
          }
        }
      },
      "api": "http://newapi.lightcomm.com/app-api/search?MaxResultCount=12",
      "label": {
        "clear": "Clear",
        "filter": "Filter",
        "total": "Results",
        "empty": "No matching results found"
      },
      "sidebar": [
        {
          "key": "keys",
          "type": "text",
          "label": "Key Words",
          "placeholder": "Please enter keywords"
        }
      ],
      "template": "<div class='bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow duration-300 p-4 border border-gray-100'> <a data-action='previewPdf' data-url='http://newapi.lightcomm.com/erupt-api/file/download-attachment{{pdf}}' class='cursor-pointer block'> <h3 class='text-lg font-semibold text-gray-900 mb-2 whitespace-normal break-all line-clamp-3'>{{name}}</h3><p class='text-sm text-gray-500 line-clamp-2 mb-3'>{{description}}</p>{{#tags}}<span class='inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mr-2 mb-2 {{colorClass}}'>{{label}}</span>{{/tags}}</a></div>",
      "wrapperClasses": "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 p-6 mx-auto",
      "colClasses": "",
      "showSidebar": false
    }
  ]
}