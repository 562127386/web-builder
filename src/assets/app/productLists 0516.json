    "tagTypes1": { "api": "http://newapi.lightcomm.com/app-api/dict?parentId=0e28bab2-30fa-74b4-57d5-3a20ea7de51f" },
    "tagTypes2": { "api": "http://newapi.lightcomm.com/app-api/dict?parentId=28885453-ef00-7cfe-6d7b-3a20ea7f5e8a" },
    "tagTypes3": { "api": "http://newapi.lightcomm.com/app-api/dict?parentId=055efc21-13b3-ce7c-529a-3a212d5ffddf"},
    "tagTypes4": { "api": "http://newapi.lightcomm.com/app-api/dict?parentId=dcbe9d9e-bf11-972a-a504-3a21314ce912"}
  },
  "html":  "<div class=\"flex flex-wrap gap-8 p-4 items-center\">\n  <div class=\"flex items-center\">\n    <label class=\"text-sm text-gray-700 mr-3 whitespace-nowrap\">按产品：</label>\n    <select data-query-field=\"tagTypes1\" class=\"border border-gray-200 rounded-md px-3 py-2 text-sm outline-none hover:border-gray-300 focus:border-gray-300 transition-colors bg-white\">\n      <option value=\"\">全部</option>\n      {{#selectOptions.tagTypes1}}\n      <option value=\"{{name}}\">{{name}}</option>\n      {{/selectOptions.tagTypes1}}\n    </select>\n  </div>\n  <div class=\"flex items-center\">\n    <label class=\"text-sm text-gray-700 mr-3 whitespace-nowrap\">按波长：</label>\n    <select data-query-field=\"tagTypes2\" class=\"border border-gray-200 rounded-md px-3 py-2 text-sm outline-none hover:border-gray-300 focus:border-gray-300 transition-colors bg-white\">\n      <option value=\"\">全部</option>\n      {{#selectOptions.tagTypes2}}\n      <option value=\"{{name}}\">{{name}}</option>\n      {{/selectOptions.tagTypes2}}\n    </select>\n  </div>\n  <div class=\"flex items-center\">\n    <label class=\"text-sm text-gray-700 mr-3 whitespace-nowrap\">按功率：</label>\n    <select data-query-field=\"tagTypes3\" class=\"border border-gray-200 rounded-md px-3 py-2 text-sm outline-none hover:border-gray-300 focus:border-gray-300 transition-colors bg-white\">\n      <option value=\"\">全部</option>\n      {{#selectOptions.tagTypes3}}\n      <option value=\"{{name}}\">{{name}}</option>\n      {{/selectOptions.tagTypes3}}\n    </select>\n  </div>\n  <div class=\"flex items-center\">\n    <label class=\"text-sm text-gray-700 mr-3 whitespace-nowrap\">按保偏/非保偏：</label>\n    <select data-query-field=\"tagTypes4\" class=\"border border-gray-200 rounded-md px-3 py-2 text-sm outline-none hover:border-gray-300 focus:border-gray-300 transition-colors bg-white\">\n      <option value=\"\">全部</option>\n      {{#selectOptions.tagTypes4}}\n      <option value=\"{{name}}\">{{name}}</option>\n      {{/selectOptions.tagTypes4}}\n    </select>\n  </div>\n</div>\n                                        <div class='grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 p-6'>{{#rows}}<a data-action='previewPdf' data-url='http://newapi.lightcomm.com/erupt-api/file/download-attachment{{pdf}}' class='inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-white border border-gray-200 text-gray-700 hover:bg-blue-50 hover:border-blue-400 hover:text-blue-600 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 ease-out cursor-pointer relative' title='{{name}}'><span class='truncate'>{{name}}</span><style>a[title]:hover::after{content:attr(title);position:absolute;bottom:100%;left:50%;transform:translateX(-50%);margin-bottom:8px;padding:10px 14px;background:#1f2937;color:white;font-size:15px;border-radius:10px;white-space:nowrap;box-shadow:0 5px 15px rgba(0,0,0,0.2);z-index:9999;pointer-events:none;}</style></a>{{/rows}}</div>"
,
